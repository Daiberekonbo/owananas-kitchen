# PostgreSQL is provisioned automatically by Replit.
DATABASE_URL=

# Use a long random value. SESSION_SECRET is accepted as a fallback locally.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173
PORT=3001

# Resend integration-backed notifications.
# RESEND_FROM_EMAIL must be a verified sender in Resend.
OWNER_EMAIL=
RESEND_FROM_EMAIL=

# Only needed once when running `npm run seed:owner`.
INITIAL_OWNER_USERNAME=
INITIAL_OWNER_PASSWORD=